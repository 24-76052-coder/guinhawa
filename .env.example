# ---------------------------------------------------------------------------
# Environment variables (all optional)
#
# Vite only exposes variables whose names start with VITE_. Copy the values you
# need into a local `.env.local` file (ignored by git) or into the Vercel
# project's Environment Variables settings. Never put database credentials here:
# the browser bundle is public.
# ---------------------------------------------------------------------------

# Path prefix the frontend is served from.
#   Local XAMPP (default when unset): /guinhawa/
#   Vercel / domain root (default in Vercel builds): /
# VITE_BASE_PATH=/guinhawa/

# Absolute URL of the PHP API.
#   Local XAMPP (default when unset): /guinhawa/api (same origin)
#   Hosted PHP: set the full URL, including the /api suffix.
# Example only - replace with your real backend host once it is deployed:
# VITE_API_URL=https://your-php-host.example.com/api
